# Contact form → Gmail SMTP (api/send-email.mjs)
# Copy to Vercel dashboard → Settings → Environment Variables (Production + Preview).

# 1. Enable 2-Step Verification on the Gmail account:
#    https://myaccount.google.com/security
# 2. Create an App Password (16 chars, no spaces):
#    https://myaccount.google.com/apppasswords
# 3. Set the three variables below.

# The Gmail address that sends the message (the account the App Password belongs to)
SMTP_USER=medali.gharsellaoui@gmail.com

# The 16-character Google App Password (NOT your normal Gmail password)
SMTP_PASS=

# The inbox that receives contact messages
SMTP_TO=medali.gharsellaoui@gmail.com
